{
  "$defs": {
    "Disagreement": {
      "additionalProperties": false,
      "description": "A label another source gave for the same decision, kept when it lost (spec \u00a78.6).",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "method": {
          "enum": [
            "rules",
            "decision_model",
            "llm",
            "classifier",
            "owner_override"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "method",
        "label"
      ],
      "title": "Disagreement",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "DM08 output: model-written text, length-limited and never more than a hypothesis (\u00a77.3).",
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "statement": {
          "maxLength": 280,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "trust_label": {
          "const": "untrusted_generated",
          "default": "untrusted_generated",
          "title": "Trust Label",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_ids"
      ],
      "title": "Hypothesis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstain_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstain Reason"
    },
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "alternatives": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "attempts": {
      "default": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "contradicting_evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Contradicting Evidence Ids",
      "type": "array"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "decision_method": {
      "enum": [
        "rules",
        "decision_model",
        "llm",
        "classifier",
        "owner_override"
      ],
      "title": "Decision Method",
      "type": "string"
    },
    "disagreements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Disagreement"
      },
      "title": "Disagreements",
      "type": "array"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "feature_set_hash": {
      "title": "Feature Set Hash",
      "type": "string"
    },
    "hypotheses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "model_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Ref"
    },
    "option_scores": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Option Scores"
    },
    "rule_outcome": {
      "enum": [
        "resolved",
        "ambiguous",
        "conflict",
        "insufficient_evidence"
      ],
      "title": "Rule Outcome",
      "type": "string"
    },
    "scope_entity": {
      "title": "Scope Entity",
      "type": "string"
    },
    "selected_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Label"
    },
    "spec": {
      "title": "Spec",
      "type": "string"
    },
    "verification_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Ref"
    }
  },
  "required": [
    "decision_id",
    "spec",
    "scope_entity",
    "feature_set_hash",
    "rule_outcome",
    "selected_label",
    "abstained",
    "decision_method"
  ],
  "title": "DecisionResult",
  "type": "object"
}
