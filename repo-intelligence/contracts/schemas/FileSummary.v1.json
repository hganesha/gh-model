{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "extractor": {
          "title": "Extractor",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "extractor",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Keyed by content, not by commit. No source text is stored here.",
      "properties": {
        "ast_node_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ast Node Kind"
        },
        "blob_sha256": {
          "title": "Blob Sha256",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observation_kind": {
          "title": "Observation Kind",
          "type": "string"
        },
        "secret_masked": {
          "default": false,
          "title": "Secret Masked",
          "type": "boolean"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "trust_label": {
          "default": "untrusted_data",
          "enum": [
            "untrusted_data",
            "untrusted_generated"
          ],
          "title": "Trust Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "blob_sha256",
        "span",
        "observation_kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceClass": {
      "description": "Ordered strongest to weakest; compare with `evidence_rank`.",
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "Extractor output: a local fact about one file. Not exposed to consumers.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "evidence",
        "payload",
        "evidence_class"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_byte",
        "end_byte",
        "start_line",
        "end_line"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blob_sha256": {
      "title": "Blob Sha256",
      "type": "string"
    },
    "body_hash": {
      "title": "Body Hash",
      "type": "string"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "interface_hash": {
      "title": "Interface Hash",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Language"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "parsed": {
      "title": "Parsed",
      "type": "boolean"
    },
    "path": {
      "title": "Path",
      "type": "string"
    }
  },
  "required": [
    "path",
    "blob_sha256",
    "language",
    "parsed",
    "interface_hash",
    "body_hash"
  ],
  "title": "FileSummary",
  "type": "object"
}
