<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="DeskDb" connectionString="Server=db.internal;Database=Desk;User Id=desk;Password=fixture-not-a-real-password;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="SmtpHost" value="mail.internal" />
    <add key="ReviewQueue" value="orders-review" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="30" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <sessionState mode="InProc" timeout="20" />
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Orders/Edit.aspx">
    <system.web>
      <authorization>
        <allow roles="Clerk, Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Audit.aspx">
    <system.web>
      <authorization>
        <allow roles="Auditor" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
