PROC 1 RUNDATE
/* NIGHTLY: allocate the run log, update the customers, then report */
CONTROL NOMSG NOFLUSH
ALLOC FI(RUNLOG) DA('PROD.CUST.RUNLOG') MOD REUSE
OPENFILE RUNLOG OUTPUT
SET &RUNLOG = &STR(NIGHTLY START &RUNDATE)
PUTFILE RUNLOG
CALL 'PROD.LOADLIB(CUSTUPD)'
IF &LASTCC NE 0 THEN GOTO FAILED
%RUNRPT &RUNDATE
EX 'PROD.EXEC(ARCHIVE)' '&RUNDATE'
CLOSFILE RUNLOG
FREE FI(RUNLOG)
EXIT CODE(0)
FAILED: WRITE CUSTUPD FAILED WITH &LASTCC
EXIT CODE(8)
