*  CUSTRPT: customer balance report.
*  Sorts the customer master by region and balance, then lists the
*  customers by region with totals.
PARM LINK(CUSTRPT R)
FILE CUSTIN FB(120 1200)
  CUST-ID       1  8 A
  CUST-NAME     *  30 A
  CUST-REGION   *  2 A
  CUST-BAL      *  7 P 2
  CUST-LIMIT    *  7 P 2
  CUST-STATUS   *  1 A
FILE SORTWK FB(120 1200)
  SRT-ID        1  8 A
  SRT-NAME      *  30 A
  SRT-REGION    *  2 A
  SRT-BAL       *  7 P 2
  SRT-LIMIT     *  7 P 2
  SRT-STATUS    *  1 A
FILE RPTOUT PRINTER
WS-COUNT       W  5 P 0
WS-OVER        W  7 P 2
*
SORT CUSTIN TO SORTWK USING (CUST-REGION CUST-BAL D) NAME SORTCUST
*
JOB INPUT SORTWK NAME CUSTLIST FINISH(WRAPUP)
  IF SRT-STATUS EQ 'C'
     GOTO JOB
  END-IF
  WS-COUNT = WS-COUNT + 1
  IF SRT-BAL GT SRT-LIMIT
     WS-OVER = SRT-BAL - SRT-LIMIT
     PERFORM FLAG-OVER
  ELSE
     WS-OVER = 0
  END-IF
  CASE SRT-REGION
    WHEN 'NE', 'NW'
      PRINT NORTHRPT
    OTHERWISE
      PRINT NORTHRPT
  END-CASE
  IF WS-OVER GT 0
     PRINT LIMITRPT
  END-IF
  SQL INSERT INTO RPT_AUDIT (CUST_ID, OVER_AMT) +
      VALUES (:SRT-ID, :WS-OVER)
*
FLAG-OVER. PROC
  CALL AUDITLOG USING SRT-ID WS-OVER
END-PROC
*
WRAPUP. PROC
  DISPLAY 'CUSTOMERS LISTED ' WS-COUNT
END-PROC
*
REPORT NORTHRPT PRINTER RPTOUT LINESIZE 132
  SEQUENCE SRT-REGION SRT-ID
  CONTROL SRT-REGION
  SUM SRT-BAL WS-OVER
  TITLE 1 'CUSTOMER BALANCES BY REGION'
  LINE 1 SRT-REGION SRT-ID SRT-NAME SRT-BAL WS-OVER
*
REPORT LIMITRPT PRINTER RPTOUT SUMMARY
  SEQUENCE SRT-REGION
  CONTROL SRT-REGION
  SUM WS-OVER
  TITLE 1 'CUSTOMERS OVER THEIR LIMIT'
  LINE 1 SRT-REGION SRT-ID WS-OVER
