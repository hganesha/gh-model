*PROCESS MARGINS(2,72) SOURCE;
 /* CUSTUPD: apply the day's customer changes to the master file  */
 /* and keep the DB2 account balances in step with them.          */
 CUSTUPD: PROC OPTIONS(MAIN) REORDER;
    %INCLUDE SYSLIB(CUSTREC);
    EXEC SQL INCLUDE SQLCA;
    DCL CUSTIN  FILE RECORD INPUT  ENV(FB RECSIZE(120));
    DCL CUSTOUT FILE RECORD OUTPUT ENV(FB RECSIZE(120));
    DCL ERRRPT  FILE STREAM OUTPUT PRINT;
    DCL DATEUTIL ENTRY(CHAR(8), FIXED BIN(31)) EXTERNAL OPTIONS(ASM);
    DCL EOF        BIT(1) INIT('0'B);
    DCL REC_COUNT  FIXED BIN(31) INIT(0);
    DCL ERR_COUNT  FIXED BIN(31) INIT(0);
    DCL RUN_DATE   CHAR(8);
    DCL RC         FIXED BIN(31);
    DCL BAL        FIXED DEC(11,2);

    ON ENDFILE(CUSTIN) EOF = '1'B;
    OPEN FILE(CUSTIN) INPUT,
         FILE(CUSTOUT) OUTPUT TITLE('CUSTNEW'),
         FILE(ERRRPT) OUTPUT;
    CALL DATEUTIL(RUN_DATE, RC);
    IF RC ^= 0 THEN DO;
       PUT FILE(ERRRPT) SKIP LIST('DATEUTIL FAILED', RC);
       STOP;
    END;

    READ FILE(CUSTIN) INTO(CUST_REC);
    DO WHILE(^EOF);
       REC_COUNT = REC_COUNT + 1;
       CALL VALIDATE(CUST_REC, RC);
       SELECT (CUST_ACTION);
          WHEN ('A', 'C') DO;
             EXEC SQL SELECT ACCT_BAL INTO :BAL
                      FROM ACCOUNTS WHERE CUST_ID = :CUST_ID;
             CUST_BALANCE = BAL;
             WRITE FILE(CUSTOUT) FROM(CUST_REC);
          END;
          WHEN ('D') DO;
             EXEC SQL DELETE FROM ACCOUNTS WHERE CUST_ID = :CUST_ID;
          END;
          OTHERWISE ERR_COUNT = ERR_COUNT + 1;
       END;
       READ FILE(CUSTIN) INTO(CUST_REC);
    END;

    EXEC SQL INSERT INTO RUN_LOG (RUN_DATE, RECORDS, ERRORS)
             VALUES (:RUN_DATE, :REC_COUNT, :ERR_COUNT);
    EXEC SQL COMMIT;
    CLOSE FILE(CUSTIN), FILE(CUSTOUT), FILE(ERRRPT);

 VALIDATE: PROC(REC, RC);
    DCL 1 REC LIKE CUST_REC;
    DCL RC FIXED BIN(31);
    RC = 0;
    IF REC.CUST_ID = '' | LENGTH(TRIM(REC.CUST_NAME)) = 0 THEN
       RC = 8;
    ELSE IF REC.CUST_BALANCE < 0 THEN
       RC = 4;
 END VALIDATE;

 END CUSTUPD;
