   ServerVersion "11.7"
END HEADER
BEGIN DSJOB
   Identifier "LoadCustomers"
   DateModified "2024-03-04"
   TimeModified "10.14.55"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "LoadCustomers"
      Description "Load the customer dimension from the landing file"
      NextID "9"
      Container "V0"
      JobVersion "56.0.0"
      Category "\\Jobs\\Customers"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "REJECT_DIR"
         Prompt "Directory for rejected rows"
         Default "/data/rejects"
         ParamType "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DW_PASSWORD"
         Prompt "Warehouse password"
         Default "not-a-real-default-0000"
         ParamType "1"
      END DSSUBRECORD
      JobType "3"
      BeforeSubr "0"
      AfterSubr "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0"
      OLEType "CContainerView"
      Name "Job"
      StageList "V0S0|V0S1|V0S2|V0S3|V0S4|V0S5|V0S6|V0S7"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0A0"
      OLEType "CAnnotation"
      Name "Note"
      AnnotationText "Customer dimension load"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0"
      OLEType "CCustomStage"
      Name "src_customers"
      OutputPins "V0S0P1"
      StageType "PxSequentialFile"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P1"
      OLEType "CCustomOutput"
      Name "lnk_src"
      Partner "V0S2|V0S2P1"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "file"
         Value "\(2)\(1)\(3)file\(2)/data/landing/customers.txt\(2)0\(1)"
      END DSSUBRECORD
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "CUST_ID"
         SqlType "4"
         KeyPosition "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "NAME"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
         SqlType "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "STATUS"
         SqlType "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "SIGNUP_DATE"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "LOAD_BATCH"
         SqlType "4"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Name "ref_country"
      OutputPins "V0S1P1"
      StageType "OracleConnectorPX"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomOutput"
      Name "lnk_country"
      Partner "V0S2|V0S2P2"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value =+=+=+=
<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>1</Context></Common><Connection><Server modified='1' type='string'><![CDATA[#DW_SERVER#]]></Server><Username modified='1' type='string'><![CDATA[etl_reader]]></Username><Password modified='1' type='protectedstring'><![CDATA[#DW_PASSWORD#]]></Password></Connection><Usage><ReadMode type='int'><![CDATA[0]]></ReadMode><GenerateSQL modified='1' type='bool'><![CDATA[0]]></GenerateSQL><SQL><SelectStatement modified='1' type='string'><![CDATA[SELECT COUNTRY_CODE, COUNTRY_NAME FROM DW.COUNTRY WHERE ACTIVE_FLAG = 'Y']]></SelectStatement></SQL></Usage></Properties>
=+=+=+=
      END DSSUBRECORD
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
         SqlType "1"
         KeyPosition "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_NAME"
         SqlType "12"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CCustomStage"
      Name "lkp_country"
      InputPins "V0S2P1|V0S2P2"
      OutputPins "V0S2P3"
      StageType "PxLookup"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CCustomInput"
      Name "lnk_src"
      Partner "V0S0|V0S0P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P2"
      OLEType "CCustomInput"
      Name "lnk_country"
      Partner "V0S1|V0S1P1"
      LookupFail "Continue"
      Columns "CCustomInputColumn"
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
         Derivation "lnk_src.COUNTRY_CODE"
         KeyPosition "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_NAME"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P3"
      OLEType "CCustomOutput"
      Name "lnk_enriched"
      Partner "V0S3|V0S3P1"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "CUST_ID"
         Derivation "lnk_src.CUST_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "NAME"
         Derivation "lnk_src.NAME"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
         Derivation "lnk_src.COUNTRY_CODE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_NAME"
         Derivation "lnk_country.COUNTRY_NAME"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "STATUS"
         Derivation "lnk_src.STATUS"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "SIGNUP_DATE"
         Derivation "lnk_src.SIGNUP_DATE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "LOAD_BATCH"
         Derivation "lnk_src.LOAD_BATCH"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CTransformerStage"
      Name "xfm_clean"
      InputPins "V0S3P1"
      OutputPins "V0S3P2|V0S3P3"
      StageType "CTransformerStage"
      StageVars "CStageVar"
      BEGIN DSSUBRECORD
         Name "svIsActive"
         Expression "If lnk_enriched.STATUS = 'A' Then 1 Else 0"
         SqlType "4"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P1"
      OLEType "CTrxInput"
      Name "lnk_enriched"
      Partner "V0S2|V0S2P3"
      Columns "CTrxInputColumn"
      BEGIN DSSUBRECORD
         Name "CUST_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "NAME"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_NAME"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "STATUS"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "SIGNUP_DATE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "LOAD_BATCH"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P2"
      OLEType "CTrxOutput"
      Name "lnk_valid"
      Partner "V0S4|V0S4P1"
      Constraint "Not(IsNull(lnk_enriched.CUST_ID)) And svIsActive = 1"
      Reject "0"
      Columns "CTrxOutputColumn"
      BEGIN DSSUBRECORD
         Name "CUST_ID"
         Derivation "lnk_enriched.CUST_ID"
         SqlType "4"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CUST_NAME"
         Derivation "Trim(lnk_enriched.NAME)"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
         Derivation "UpCase(lnk_enriched.COUNTRY_CODE)"
         SqlType "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_NAME"
         Derivation "NullToValue(lnk_enriched.COUNTRY_NAME, 'Unknown')"
         SqlType "12"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "SIGNUP_DATE"
         Derivation "StringToDate(lnk_enriched.SIGNUP_DATE, \"%yyyy-%mm-%dd\")"
         SqlType "9"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "IS_VIP"
         Derivation "If lnk_enriched.CUST_ID < 1000 Then 'Y' Else 'N'"
         SqlType "1"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P3"
      OLEType "CTrxOutput"
      Name "lnk_reject"
      Partner "V0S7|V0S7P1"
      Constraint "IsNull(lnk_enriched.CUST_ID) Or svIsActive = 0"
      Reject "0"
      Columns "CTrxOutputColumn"
      BEGIN DSSUBRECORD
         Name "CUST_ID"
         Derivation "lnk_enriched.CUST_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "REASON"
         Derivation "If IsNull(lnk_enriched.CUST_ID) Then 'missing id' Else 'inactive'"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CCustomStage"
      Name "srt_cust"
      InputPins "V0S4P1"
      OutputPins "V0S4P2"
      StageType "PxSort"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "key"
         Value "\(2)\(1)\(3)key\(2)CUST_ID\(2)\(1)\(3)asc_desc\(2)Ascending\(1)"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P1"
      OLEType "CCustomInput"
      Name "lnk_valid"
      Partner "V0S3|V0S3P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P2"
      OLEType "CCustomOutput"
      Name "lnk_sorted"
      Partner "V0S5|V0S5P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5"
      OLEType "CCustomStage"
      Name "rmd_cust"
      InputPins "V0S5P1"
      OutputPins "V0S5P2"
      StageType "PxRemDup"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "key"
         Value "\(2)\(1)\(3)key\(2)CUST_ID\(1)"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5P1"
      OLEType "CCustomInput"
      Name "lnk_sorted"
      Partner "V0S4|V0S4P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S5P2"
      OLEType "CCustomOutput"
      Name "lnk_unique"
      Partner "V0S6|V0S6P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S6"
      OLEType "CCustomStage"
      Name "tgt_customers"
      InputPins "V0S6P1"
      StageType "OracleConnectorPX"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S6P1"
      OLEType "CCustomInput"
      Name "lnk_unique"
      Partner "V0S5|V0S5P2"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value =+=+=+=
<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Connection><Server modified='1' type='string'><![CDATA[#DW_SERVER#]]></Server><Password modified='1' type='protectedstring'><![CDATA[#DW_PASSWORD#]]></Password></Connection><Usage><WriteMode modified='1' type='int'><![CDATA[3]]></WriteMode><GenerateSQL modified='1' type='bool'><![CDATA[0]]></GenerateSQL><SQL><InsertStatement modified='1' type='string'><![CDATA[INSERT INTO DW.CUSTOMERS (CUST_ID, CUST_NAME, COUNTRY_CODE, COUNTRY_NAME, SIGNUP_DATE, IS_VIP) VALUES (ORCHESTRATE.CUST_ID, ORCHESTRATE.CUST_NAME, ORCHESTRATE.COUNTRY_CODE, ORCHESTRATE.COUNTRY_NAME, ORCHESTRATE.SIGNUP_DATE, ORCHESTRATE.IS_VIP)]]></InsertStatement><UpdateStatement modified='1' type='string'><![CDATA[UPDATE DW.CUSTOMERS SET CUST_NAME = ORCHESTRATE.CUST_NAME, COUNTRY_CODE = ORCHESTRATE.COUNTRY_CODE, COUNTRY_NAME = ORCHESTRATE.COUNTRY_NAME, IS_VIP = ORCHESTRATE.IS_VIP WHERE CUST_ID = ORCHESTRATE.CUST_ID]]></UpdateStatement></SQL></Usage></Properties>
=+=+=+=
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S7"
      OLEType "CCustomStage"
      Name "tgt_rejects"
      InputPins "V0S7P1"
      StageType "PxSequentialFile"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S7P1"
      OLEType "CCustomInput"
      Name "lnk_reject"
      Partner "V0S3|V0S3P3"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "file"
         Value "\(2)\(1)\(3)file\(2)#REJECT_DIR#/customers_rejects.txt\(2)0\(1)"
      END DSSUBRECORD
   END DSRECORD
END DSJOB
BEGIN DSTABLEDEFS
   BEGIN DSRECORD
      Identifier "Database\\DWH\\DW.CUSTOMERS"
      OLEType "CMetaTable"
      Readonly "0"
