BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "ETLHOST01"
   ToolInstanceID "DWH"
   MDISVersion "1.0"
   Date "2024-03-04"
