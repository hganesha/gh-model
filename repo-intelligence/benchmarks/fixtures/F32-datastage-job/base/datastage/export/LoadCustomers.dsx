      BEGIN DSSUBRECORD
         Name "CUST_ID"
         SqlType "4"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CUST_NAME"
         SqlType "12"
         Precision "100"
         Scale "0"
         Nullable "1"
         KeyPosition "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "COUNTRY_CODE"
         SqlType "1"
         Precision "2"
         Scale "0"
         Nullable "1"
         KeyPosition "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "SIGNUP_DATE"
         SqlType "9"
         Precision "10"
         Scale "0"
         Nullable "1"
         KeyPosition "0"
      END DSSUBRECORD
   END DSRECORD
END DSTABLEDEFS
