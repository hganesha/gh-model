BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "ETLHOST01"
   ToolInstanceID "DWH"
   MDISVersion "1.0"
   Date "2024-03-04"
   Time "10.16.40"
   ServerVersion "11.7"
END HEADER
BEGIN DSJOB
   Identifier "NightlyLoad"
   DateModified "2024-03-04"
   TimeModified "10.16.31"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "NightlyLoad"
      Description "Nightly warehouse load: customers, then orders"
      NextID "6"
      Container "V0"
      Category "\\Jobs\\Sequences"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "RUN_DATE"
         Prompt "Business date"
         Default "2024-01-01"
         ParamType "0"
      END DSSUBRECORD
      JobType "2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0"
      OLEType "CContainerView"
      Name "Job"
      StageList "V0S0|V0S1|V0S2|V0S3|V0S4"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0"
      OLEType "CJSRoutineActivity"
      Name "chk_landing"
      OutputPins "V0S0P1|V0S0P2"
      StageType "CJSRoutineActivity"
      RoutineName "CheckLandingFile"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P1"
      OLEType "CJSActivityOutput"
      Name "ready"
      Partner "V0S1|V0S1P1"
      ConditionType "4"
      Expression "chk_landing.$ReturnValue = 0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P2"
      OLEType "CJSActivityOutput"
      Name "missing"
      Partner "V0S3|V0S3P1"
      ConditionType "4"
      Expression "chk_landing.$ReturnValue <> 0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CJSJobActivity"
      Name "run_customers"
      InputPins "V0S1P1"
      OutputPins "V0S1P2|V0S1P3"
      StageType "CJSJobActivity"
      Jobname "LoadCustomers"
      ExecutionAction "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CJSActivityInput"
      Name "ready"
      Partner "V0S0|V0S0P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P2"
      OLEType "CJSActivityOutput"
      Name "customers_ok"
      Partner "V0S2|V0S2P1"
      ConditionType "1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P3"
      OLEType "CJSActivityOutput"
      Name "customers_failed"
      Partner "V0S3|V0S3P2"
      ConditionType "2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CJSJobActivity"
      Name "run_orders"
      InputPins "V0S2P1"
      StageType "CJSJobActivity"
      Jobname "LoadOrders"
      ExecutionAction "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CJSActivityInput"
      Name "customers_ok"
      Partner "V0S1|V0S1P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CJSMailActivity"
      Name "notify_support"
      InputPins "V0S3P1|V0S3P2"
      OutputPins "V0S3P3"
      StageType "CJSMailActivity"
      SenderAddress "etl@example.invalid"
      RecipientAddress "dwh-support@example.invalid"
      Subject "Nightly load failed"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P1"
      OLEType "CJSActivityInput"
      Name "missing"
      Partner "V0S0|V0S0P2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P2"
      OLEType "CJSActivityInput"
      Name "customers_failed"
      Partner "V0S1|V0S1P3"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P3"
      OLEType "CJSActivityOutput"
      Name "after_notify"
      Partner "V0S4|V0S4P1"
      ConditionType "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4"
      OLEType "CJSTerminatorActivity"
      Name "stop_sequence"
      InputPins "V0S4P1"
      StageType "CJSTerminatorActivity"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S4P1"
      OLEType "CJSActivityInput"
      Name "after_notify"
      Partner "V0S3|V0S3P3"
   END DSRECORD
END DSJOB
