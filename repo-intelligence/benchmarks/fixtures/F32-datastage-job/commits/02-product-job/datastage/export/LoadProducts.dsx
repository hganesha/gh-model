BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "ETLHOST01"
   ToolInstanceID "DWH"
   Date "2024-03-11"
   Time "09.02.17"
   ServerVersion "11.7"
END HEADER
BEGIN DSJOB
   Identifier "LoadProducts"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Name "LoadProducts"
      Description "Load the product dimension"
      Category "\\Jobs\\Products"
      JobType "3"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0"
      OLEType "CCustomStage"
      Name "src_products"
      OutputPins "V0S0P1"
      StageType "PxSequentialFile"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P1"
      OLEType "CCustomOutput"
      Name "lnk_src"
      Partner "V0S1|V0S1P1"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "file"
         Value "\(2)\(1)\(3)file\(2)/data/landing/products.csv\(2)0\(1)"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Name "mod_products"
      InputPins "V0S1P1"
      OutputPins "V0S1P2"
      StageType "PxModify"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "specification"
         Value "\(2)\(1)\(3)specification\(2)PRODUCT_NAME = PROD_NM\(1)"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "specification"
         Value "\(2)\(1)\(3)specification\(2)DROP LEGACY_CODE\(1)"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomInput"
      Name "lnk_src"
      Partner "V0S0|V0S0P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P2"
      OLEType "CCustomOutput"
      Name "lnk_out"
      Partner "V0S2|V0S2P1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CCustomStage"
      Name "tgt_products"
      InputPins "V0S2P1"
      StageType "DB2ConnectorPX"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CCustomInput"
      Name "lnk_out"
      Partner "V0S1|V0S1P2"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "XMLProperties"
         Value =+=+=+=
<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Connection><Database modified='1' type='string'><![CDATA[#DB2_DATABASE#]]></Database></Connection><Usage><WriteMode modified='1' type='int'><![CDATA[0]]></WriteMode><TableName modified='1' type='string'><![CDATA[DW.PRODUCTS]]></TableName><TableAction modified='1' type='int'><![CDATA[3]]></TableAction></Usage></Properties>
=+=+=+=
      END DSSUBRECORD
   END DSRECORD
END DSJOB
