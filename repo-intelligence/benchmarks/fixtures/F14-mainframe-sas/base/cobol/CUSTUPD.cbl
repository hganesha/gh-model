       IDENTIFICATION DIVISION.
       PROGRAM-ID. CUSTUPD.
      *    APPLY DAILY CUSTOMER CHANGES TO THE MASTER AND DB2
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUST-IN ASSIGN TO CUSTIN.
       DATA DIVISION.
       FILE SECTION.
       FD  CUST-IN.
           COPY CUSTREC.
       WORKING-STORAGE SECTION.
       01  WS-TODAY        PIC X(10).
       01  WS-PGM          PIC X(8) VALUE 'AUDITLOG'.
           EXEC SQL INCLUDE SQLCA END-EXEC.
       PROCEDURE DIVISION.
           CALL 'DATEUTIL' USING WS-TODAY.
           READ CUST-IN.
           EXEC SQL
               UPDATE CUSTOMER
                  SET CUST_NAME = :CUST-NAME, UPDATED = :WS-TODAY
                WHERE CUST_ID = :CUST-ID
           END-EXEC.
           EXEC SQL
               INSERT INTO CUST_HIST (CUST_ID, CHANGED)
               SELECT CUST_ID, CURRENT DATE FROM CUSTOMER
                WHERE CUST_ID = :CUST-ID
           END-EXEC.
           CALL WS-PGM USING CUST-ID.
           GOBACK.
