//CUSTJOB  JOB (ACCT),'DAILY CUSTOMER',CLASS=A,MSGCLASS=X
//*  DAILY CUSTOMER MAINTENANCE
//STEP010  EXEC PGM=SORT
//SORTIN   DD DSN=PROD.CUST.DAILY.EXTRACT,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS)
//SYSIN    DD *
  SORT FIELDS=(1,9,CH,A)
/*
//STEP020  EXEC PGM=IKJEFT01
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//CUSTIN   DD DSN=&&SORTED,DISP=(OLD,DELETE)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CUSTUPD) PLAN(CUSTPLN)
  END
/*
//STEP030  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=PROD.CUST.DAILY.EXTRACT,DISP=SHR
//SYSUT2   DD DSN=PROD.CUST.ARCHIVE(+1),DISP=(NEW,CATLG),
//            SPACE=(CYL,(10,5))
