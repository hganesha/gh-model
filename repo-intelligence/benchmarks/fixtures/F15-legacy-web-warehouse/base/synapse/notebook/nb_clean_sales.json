        "cells": [
            {
                "cell_type": "code",
                "metadata": {},
                "source": [
                    "raw = spark.read.parquet(\"abfss://raw@salesdata.dfs.core.windows.net/sales\")\n",
                    "clean = raw.dropDuplicates([\"sale_id\"]).filter(\"amount > 0\")\n",
                    "clean.write.mode(\"overwrite\").saveAsTable(\"stg.sales_clean\")\n"
                ]
            }
        ]
    }
}