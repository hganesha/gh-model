*  CUSTOMER INQUIRY AND ORDER LIST MAPS FOR THE CICS DESK
CUSTSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB,FRSET)
*
CUSTMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,25),LENGTH=16,ATTRB=(ASKIP,BRT),                X
               INITIAL='CUSTOMER INQUIRY'
         DFHMDF POS=(3,1),LENGTH=12,ATTRB=ASKIP,INITIAL='CUSTOMER NO:'
CUSTNO   DFHMDF POS=(3,14),LENGTH=8,ATTRB=(UNPROT,NUM,IC,FSET),        X
               PICIN='9(8)'
         DFHMDF POS=(3,23),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(5,1),LENGTH=5,ATTRB=ASKIP,INITIAL='NAME:'
CUSTNM   DFHMDF POS=(5,14),LENGTH=30,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(6,1),LENGTH=8,ATTRB=ASKIP,INITIAL='BALANCE:'
CUSTBAL  DFHMDF POS=(6,14),LENGTH=12,ATTRB=ASKIP,                      X
               PICOUT='ZZZ,ZZ9.99-'
         DFHMDF POS=(7,1),LENGTH=6,ATTRB=ASKIP,INITIAL='PHONE:'
CUSTPHN  DFHMDF POS=(7,14),LENGTH=15,ATTRB=(UNPROT,FSET)
         DFHMDF POS=(7,30),LENGTH=1,ATTRB=ASKIP
MSGLINE  DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT),COLOR=RED
         DFHMDF POS=(24,1),LENGTH=33,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF5=ORDERS  ENTER=SHOW'
         DFHMSD TYPE=FINAL
         END
