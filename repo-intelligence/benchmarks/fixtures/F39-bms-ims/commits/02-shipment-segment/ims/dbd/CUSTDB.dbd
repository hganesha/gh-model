*  CUSTOMER DATABASE: CUSTOMERS, THEIR ORDERS AND ORDER LINES
         DBD     NAME=CUSTDB,ACCESS=(HIDAM,VSAM)
         DATASET DD1=CUSTDD,DEVICE=3390,SIZE=4096
*
         SEGM    NAME=CUSTOMER,PARENT=0,BYTES=120,                     X
               POINTER=TWINBWD
         LCHILD  NAME=(CUSTIDX,CUSTIDXD),POINTER=INDX
         FIELD   NAME=(CUSTNO,SEQ,U),BYTES=8,START=1,TYPE=C
         FIELD   NAME=CUSTNAME,BYTES=30,START=9,TYPE=C
         FIELD   NAME=BALANCE,BYTES=6,START=39,TYPE=P
*
         SEGM    NAME=ORDER,PARENT=CUSTOMER,BYTES=60
         FIELD   NAME=(ORDNO,SEQ,U),BYTES=10,START=1,TYPE=C
         FIELD   NAME=ORDDATE,BYTES=8,START=11,TYPE=C
         FIELD   NAME=STATUS,BYTES=1,START=19,TYPE=C
*
         SEGM    NAME=ORDLINE,PARENT=((ORDER,SNGL)),BYTES=40
         FIELD   NAME=(LINENO,SEQ,U),BYTES=3,START=1,TYPE=Z
         FIELD   NAME=ITEMNO,BYTES=12,START=4,TYPE=C
         FIELD   NAME=QTY,BYTES=4,START=16,TYPE=P
*
         SEGM    NAME=SHIPMENT,PARENT=ORDER,BYTES=32
         FIELD   NAME=(SHIPNO,SEQ,U),BYTES=10,START=1,TYPE=C
         FIELD   NAME=SHIPDATE,BYTES=8,START=11,TYPE=C
         FIELD   NAME=CARRIER,BYTES=14,START=19,TYPE=C
         DBDGEN
         FINISH
         END
