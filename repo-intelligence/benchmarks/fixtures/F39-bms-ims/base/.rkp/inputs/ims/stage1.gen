*  IMS SYSTEM DEFINITION, STAGE 1: APPLICATIONS AND TRANSACTIONS
         IMSCTRL SYSTEM=(VS/2,(ALL,DB/DC)),IMSID=IMSA
         DATABASE DBD=CUSTDB,ACCESS=UP
*
         APPLCTN PSB=CUSTPGM,PGMTYPE=TP,SCHDTYP=PARALLEL
         TRANSACT CODE=CUSTINQ,MSGTYPE=(SNGLSEG,RESPONSE,1),           X
               PRTY=(7,10,2),MODE=SNGL
         TRANSACT CODE=CUSTUPD,MSGTYPE=(MULTSEG,NONRESPONSE,1),SPA=80
*
         APPLCTN PSB=ORDPGM,PGMTYPE=TP
         TRANSACT CODE=ORDNOTE,MSGTYPE=(SNGLSEG,NONRESPONSE,2)
*
         APPLCTN PSB=CUSTBAT,PGMTYPE=BATCH
         IMSGEN ASM=(HLASM,SYSLIN),ASMPRT=OFF,LKPRT=(XREF,LIST)
         END
