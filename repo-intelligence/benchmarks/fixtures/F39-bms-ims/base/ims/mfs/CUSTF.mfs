*  CUSTOMER INQUIRY FORMAT FOR 3270 TERMINALS
         PRINT  NOGEN
CUSTF    FMT
         DEV    TYPE=(3270,2),FEAT=IGNORE,SYSMSG=MSGLINE,              X
               PFK=(PFKEYS,'CUSTINQ ','CUSTUPD ')
         DIV    TYPE=INOUT
         DPAGE  CURSOR=((3,14))
         DFLD   'CUSTOMER INQUIRY',POS=(1,25)
         DFLD   'CUSTOMER NO:',POS=(3,1)
CUSTNO   DFLD   POS=(3,14),LTH=8,ATTR=(NUM,MOD)
         DFLD   'NAME:',POS=(5,1)
CUSTNM   DFLD   POS=(5,14),LTH=30,ATTR=(PROT)
MSGLINE  DFLD   POS=(23,1),LTH=79,ATTR=(PROT,HI)
         FMTEND
*
CUSTIN   MSG    TYPE=INPUT,SOR=(CUSTF,IGNORE),NXT=CUSTOUT
         SEG
         MFLD   'CUSTINQ '
         MFLD   PFKEYS,LTH=8
         MFLD   CUSTNO,LTH=8,JUST=R,FILL=C'0'
         MSGEND
*
CUSTOUT  MSG    TYPE=OUTPUT,SOR=(CUSTF,IGNORE),NXT=CUSTIN
         SEG
         MFLD   CUSTNO,LTH=8
         MFLD   CUSTNM,LTH=30
         MFLD   MSGLINE,LTH=79
         MSGEND
         END
