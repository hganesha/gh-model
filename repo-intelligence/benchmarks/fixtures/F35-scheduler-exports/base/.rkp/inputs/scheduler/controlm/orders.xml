<?xml version="1.0" encoding="utf-8"?>
<!-- Control-M Workload Automation export: order processing and the payroll jobs moving from CA-7 -->
<DEFTABLE xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Folder.xsd">
  <SMART_FOLDER DATACENTER="ctm-prod" FOLDER_NAME="ORDERS_DAILY" APPLICATION="ORDERS" SUB_APPLICATION="DAILY" WEEKDAYS="1,2,3,4,5" DAYSCAL="WORKDAYS" TIMEFROM="0100">
    <JOB JOBNAME="EXTRACT_ORDERS" APPLICATION="ORDERS" SUB_APPLICATION="DAILY" DESCRIPTION="Extract the day's orders" TASKTYPE="Job" MEMNAME="extract_orders.sh" MEMLIB="/opt/batch/scripts" NODEID="batchhost01" RUN_AS="batchsvc" WEEKDAYS="1,2,3,4,5" DAYSCAL="WORKDAYS" CONFCAL="HOLIDAYS" TIMEFROM="0130">
      <OUTCOND NAME="EXTRACT_ORDERS-OK" ODATE="ODAT" SIGN="+" />
      <QUANTITATIVE NAME="ORDERS_DB" QUANT="1" ONFAIL="R" ONOK="R" />
      <ON STMT="*" CODE="NOTOK">
        <DOSHOUT URGENCY="R" DEST="ops-team" MESSAGE="Order extract failed" />
      </ON>
    </JOB>
    <JOB JOBNAME="LOAD_ORDERS" APPLICATION="ORDERS" SUB_APPLICATION="DAILY" DESCRIPTION="Load the staged orders" TASKTYPE="Command" CMDLINE="/opt/batch/scripts/load_orders.sh %%ODATE" NODEID="batchhost01" RUN_AS="batchsvc">
      <INCOND NAME="EXTRACT_ORDERS-OK" ODATE="ODAT" AND_OR="A" />
      <OUTCOND NAME="EXTRACT_ORDERS-OK" ODATE="ODAT" SIGN="-" />
      <OUTCOND NAME="LOAD_ORDERS-OK" ODATE="ODAT" SIGN="+" />
      <VARIABLE NAME="%%TARGET_SCHEMA" VALUE="orders_stage" />
    </JOB>
    <JOB JOBNAME="ORDERS_DONE" APPLICATION="ORDERS" SUB_APPLICATION="DAILY" DESCRIPTION="Orders are loaded for the day" TASKTYPE="Dummy">
      <INCOND NAME="LOAD_ORDERS-OK" ODATE="ODAT" AND_OR="A" />
      <INCOND NAME="FINANCE-READY" ODATE="PREV" AND_OR="A" />
      <OUTCOND NAME="ORDERS-DONE" ODATE="ODAT" SIGN="+" />
    </JOB>
    <RULE_BASED_CALENDARS NAME="ORDER_DAYS" />
  </SMART_FOLDER>
  <FOLDER DATACENTER="ctm-zos" FOLDER_NAME="PAYROLL_ZOS">
    <JOB JOBNAME="PAYJ010" APPLICATION="PAYROLL" MEMNAME="PAYJ010" MEMLIB="PROD.PAYROLL.JCL" TASKTYPE="Job" DAYS="ALL" TIMEFROM="2200">
      <OUTCOND NAME="PAYJ010-ENDED-OK" ODATE="ODAT" SIGN="+" />
    </JOB>
    <JOB JOBNAME="PAYJ030" APPLICATION="PAYROLL" MEMNAME="%%PAYMEMBER" MEMLIB="PROD.PAYROLL.JCL" TASKTYPE="Job">
      <INCOND NAME="PAYJ010-ENDED-OK" ODATE="ODAT" AND_OR="A" />
    </JOB>
  </FOLDER>
</DEFTABLE>
