load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "api_lib",
    srcs = glob(["*.go"]),
    importpath = "example.com/shop/services/api",
    deps = [
        "//libs/auth",
        "//libs/db",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "api_test",
    srcs = ["main_test.go"],
    embed = [":api_lib"],
)
