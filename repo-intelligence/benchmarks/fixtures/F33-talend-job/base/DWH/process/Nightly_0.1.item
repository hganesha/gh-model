<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="" name="run_date" prompt="run_date?" promptNeeded="false" type="id_String" value="2024-01-01"/>
  </context>
  <node componentName="tRunJob" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tRunJob_1"/>
    <elementParameter field="LABEL" name="LABEL" value="customers"/>
    <elementParameter field="PROCESS_TYPE" name="PROCESS" value="LoadCustomers"/>
    <elementParameter field="TECHNICAL" name="PROCESS:PROCESS_TYPE_PROCESS" value="_c2"/>
    <elementParameter field="TECHNICAL" name="PROCESS:PROCESS_TYPE_VERSION" value="Latest"/>
    <elementParameter field="CHECK" name="TRANSMIT_WHOLE_CONTEXT" value="true"/>
    <elementParameter field="CHECK" name="DIE_ON_CHILD_ERROR" value="false"/>
  </node>
  <node componentName="tRunJob" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="256" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tRunJob_2"/>
    <elementParameter field="LABEL" name="LABEL" value="orders"/>
    <elementParameter field="PROCESS_TYPE" name="PROCESS" value="LoadOrders"/>
    <elementParameter field="TECHNICAL" name="PROCESS:PROCESS_TYPE_PROCESS" value="_o2"/>
    <elementParameter field="CHECK" name="TRANSMIT_WHOLE_CONTEXT" value="true"/>
  </node>
  <node componentName="tSendMail" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="256" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tSendMail_1"/>
    <elementParameter field="TEXT" name="TO" value="&quot;dwh-support@fixture.invalid&quot;"/>
    <elementParameter field="TEXT" name="FROM" value="&quot;etl@fixture.invalid&quot;"/>
    <elementParameter field="TEXT" name="SMTP_HOST" value="&quot;mail.fixture.invalid&quot;"/>
    <elementParameter field="TEXT" name="SUBJECT" value="&quot;Nightly load failed&quot;"/>
  </node>
  <node componentName="tDie" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="448" posY="192">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDie_1"/>
    <elementParameter field="TEXT" name="MESSAGE" value="&quot;the nightly load failed&quot;"/>
  </node>
  <connection connectorName="RUN_IF" label="If (customers ok)" lineStyle="6" metaname="tRunJob_1" offsetLabelX="0" offsetLabelY="0" source="tRunJob_1" target="tRunJob_2">
    <elementParameter field="MEMO_JAVA" name="CONDITION" value="((Integer) globalMap.get(&quot;tRunJob_1_CHILD_RETURN_CODE&quot;)) == 0"/>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="If1"/>
  </connection>
  <connection connectorName="RUN_IF" label="If (customers failed)" lineStyle="6" metaname="tRunJob_1" offsetLabelX="0" offsetLabelY="0" source="tRunJob_1" target="tSendMail_1">
    <elementParameter field="MEMO_JAVA" name="CONDITION" value="((Integer) globalMap.get(&quot;tRunJob_1_CHILD_RETURN_CODE&quot;)) != 0"/>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="If2"/>
  </connection>
  <connection connectorName="COMPONENT_OK" label="OnComponentOk" lineStyle="3" metaname="tSendMail_1" offsetLabelX="0" offsetLabelY="0" source="tSendMail_1" target="tDie_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="OnComponentOk1"/>
  </connection>
</talendfile:ProcessType>
