<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" xmlns:mapper="http://www.talend.org/mapper" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="" name="reject_dir" prompt="reject_dir?" promptNeeded="false" type="id_Directory" value="/data/rejects/fixture-not-a-real-dir"/>
    <contextParameter comment="" name="dw_password" prompt="dw_password?" promptNeeded="false" type="id_Password" value="enc:system.encryption.key.v1:FIXTURE-NOT-A-REAL-SECRET=="/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="JOB_RUN_VM_ARGUMENTS" value=" -Xms256M -Xmx1024M"/>
  </parameters>
  <node componentName="tPrejob" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="32">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tPrejob_1"/>
  </node>
  <node componentName="tOracleConnection" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="224" posY="32">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tOracleConnection_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;dwhost.fixture.invalid&quot;"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;1521&quot;"/>
    <elementParameter field="TEXT" name="USER" value="&quot;fixture_etl_user&quot;"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.dw_password"/>
  </node>
  <node componentName="tFileInputDelimited" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileInputDelimited_1"/>
    <elementParameter field="LABEL" name="LABEL" value="read_customers"/>
    <elementParameter field="FILE" name="FILENAME" value="&quot;/data/landing/customers.csv&quot;"/>
    <elementParameter field="TEXT" name="FIELDSEPARATOR" value="&quot;;&quot;"/>
    <metadata connector="FLOW" label="tFileInputDelimited_1" name="tFileInputDelimited_1">
      <column key="true" length="10" name="CUST_ID" nullable="false" type="id_Integer"/>
      <column key="false" length="100" name="CUST_NAME" nullable="true" type="id_String"/>
      <column key="false" length="2" name="COUNTRY_CODE" nullable="true" type="id_String"/>
      <column key="false" length="1" name="STATUS" nullable="true" type="id_String"/>
      <column key="false" length="10" name="SEGMENT" nullable="true" type="id_String"/>
      <column key="false" length="10" name="SIGNUP_DATE" nullable="true" type="id_String"/>
    </metadata>
  </node>
  <node componentName="tOracleInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="224" posY="288">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tOracleInput_1"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tOracleConnection_1"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;COUNTRY&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT COUNTRY_CODE, COUNTRY_NAME FROM DW.COUNTRY WHERE ACTIVE = 'Y'&quot;"/>
    <metadata connector="FLOW" label="tOracleInput_1" name="tOracleInput_1">
      <column key="true" length="2" name="COUNTRY_CODE" nullable="false" type="id_String"/>
      <column key="false" length="60" name="COUNTRY_NAME" nullable="true" type="id_String"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="384" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1"/>
    <elementParameter field="LABEL" name="LABEL" value="clean_customers"/>
    <nodeData xsi:type="mapper:MapperData">
      <varTables name="Var" sizeState="INTERMEDIATE">
        <mapperTableEntries name="isVip" expression="row1.SEGMENT != null &amp;&amp; row1.SEGMENT.equals(&quot;VIP&quot;)" type="id_Boolean"/>
      </varTables>
      <outputTables name="out_valid" sizeState="INTERMEDIATE" activateExpressionFilter="true" expressionFilter="row1.CUST_ID != null &amp;&amp; &quot;A&quot;.equals(row1.STATUS)">
        <mapperTableEntries name="CUST_ID" expression="row1.CUST_ID" type="id_Integer" nullable="false"/>
        <mapperTableEntries name="CUST_NAME" expression="StringHandling.TRIM(row1.CUST_NAME)" type="id_String" nullable="true"/>
        <mapperTableEntries name="COUNTRY_CODE" expression="row1.COUNTRY_CODE.toUpperCase()" type="id_String" nullable="true"/>
        <mapperTableEntries name="COUNTRY_NAME" expression="row2.COUNTRY_NAME == null ? &quot;Unknown&quot; : row2.COUNTRY_NAME" type="id_String" nullable="true"/>
        <mapperTableEntries name="SIGNUP_DATE" expression="TalendDate.parseDate(&quot;yyyy-MM-dd&quot;, row1.SIGNUP_DATE)" type="id_Date" nullable="true"/>
        <mapperTableEntries name="IS_VIP" expression="Var.isVip ? &quot;Y&quot; : &quot;N&quot;" type="id_String" nullable="true"/>
      </outputTables>
      <outputTables name="out_reject" sizeState="INTERMEDIATE" reject="true">
        <mapperTableEntries name="CUST_ID" expression="row1.CUST_ID" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="REASON" expression="&quot;invalid customer&quot;" type="id_String" nullable="true"/>
      </outputTables>
      <inputTables lookupMode="LOAD_ONCE" matchingMode="UNIQUE_MATCH" name="row1" sizeState="INTERMEDIATE">
        <mapperTableEntries name="CUST_ID" type="id_Integer" nullable="false"/>
        <mapperTableEntries name="CUST_NAME" type="id_String" nullable="true"/>
        <mapperTableEntries name="COUNTRY_CODE" type="id_String" nullable="true"/>
        <mapperTableEntries name="STATUS" type="id_String" nullable="true"/>
        <mapperTableEntries name="SEGMENT" type="id_String" nullable="true"/>
        <mapperTableEntries name="SIGNUP_DATE" type="id_String" nullable="true"/>
      </inputTables>
      <inputTables innerJoin="false" lookupMode="LOAD_ONCE" matchingMode="UNIQUE_MATCH" name="row2" sizeState="INTERMEDIATE">
        <mapperTableEntries name="COUNTRY_CODE" expression="row1.COUNTRY_CODE" type="id_String" nullable="false"/>
        <mapperTableEntries name="COUNTRY_NAME" type="id_String" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>
  <node componentName="tSortRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="544" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tSortRow_1"/>
    <elementParameter field="TABLE" name="CRITERIA">
      <elementValue elementRef="COLNAME" value="CUST_ID"/>
      <elementValue elementRef="SORT" value="num"/>
      <elementValue elementRef="ORDER" value="asc"/>
    </elementParameter>
  </node>
  <node componentName="tUniqRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="704" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tUniqRow_1"/>
    <elementParameter field="TABLE" name="UNIQUE_KEY">
      <elementValue elementRef="SCHEMA_COLUMN" value="CUST_ID"/>
      <elementValue elementRef="KEY_ATTRIBUTE" value="true"/>
      <elementValue elementRef="CASE_SENSITIVE" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="CUST_NAME"/>
      <elementValue elementRef="KEY_ATTRIBUTE" value="false"/>
      <elementValue elementRef="CASE_SENSITIVE" value="false"/>
    </elementParameter>
  </node>
  <node componentName="tOracleOutput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="864" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tOracleOutput_1"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tOracleConnection_1"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;DW&quot;"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;CUSTOMERS&quot;"/>
    <elementParameter field="CLOSED_LIST" name="TABLE_ACTION" value="NONE"/>
    <elementParameter field="CLOSED_LIST" name="DATA_ACTION" value="INSERT_OR_UPDATE"/>
  </node>
  <node componentName="tFileOutputDelimited" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="544" posY="288">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileOutputDelimited_1"/>
    <elementParameter field="FILE" name="FILENAME" value="context.reject_dir + &quot;/customers_rejects.csv&quot;"/>
  </node>
  <node componentName="tPostjob" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="416">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tPostjob_1"/>
  </node>
  <node componentName="tOracleClose" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="224" posY="416">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tOracleClose_1"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tOracleConnection_1"/>
  </node>
  <connection connectorName="SUBJOB_OK" label="OnSubjobOk" lineStyle="1" metaname="tPrejob_1" offsetLabelX="0" offsetLabelY="0" source="tPrejob_1" target="tOracleConnection_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="OnSubjobOk1"/>
  </connection>
  <connection connectorName="FLOW" label="row1" lineStyle="0" metaname="tFileInputDelimited_1" offsetLabelX="0" offsetLabelY="0" source="tFileInputDelimited_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row1"/>
  </connection>
  <connection connectorName="FLOW" label="row2" lineStyle="8" metaname="tOracleInput_1" offsetLabelX="0" offsetLabelY="0" source="tOracleInput_1" target="tMap_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row2"/>
  </connection>
  <connection connectorName="FLOW" label="out_valid" lineStyle="0" metaname="out_valid" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tSortRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="out_valid"/>
  </connection>
  <connection connectorName="FLOW" label="out_reject" lineStyle="0" metaname="out_reject" offsetLabelX="0" offsetLabelY="0" source="tMap_1" target="tFileOutputDelimited_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="out_reject"/>
  </connection>
  <connection connectorName="FLOW" label="row3" lineStyle="0" metaname="tSortRow_1" offsetLabelX="0" offsetLabelY="0" source="tSortRow_1" target="tUniqRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row3"/>
  </connection>
  <connection connectorName="UNIQUE" label="row4" lineStyle="0" metaname="tUniqRow_1" offsetLabelX="0" offsetLabelY="0" source="tUniqRow_1" target="tOracleOutput_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="row4"/>
  </connection>
  <connection connectorName="SUBJOB_OK" label="OnSubjobOk" lineStyle="1" metaname="tPostjob_1" offsetLabelX="0" offsetLabelY="0" source="tPostjob_1" target="tOracleClose_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="OnSubjobOk2"/>
  </connection>
  <subjob>
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileInputDelimited_1"/>
  </subjob>
</talendfile:ProcessType>
