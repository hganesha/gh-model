<?xml version="1.0" encoding="UTF-8"?>
<talendfile:ProcessType xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd" defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="" name="run_date" prompt="run_date?" promptNeeded="false" type="id_String" value="2024-01-01"/>
  </context>
  <node componentName="tPostgresqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tPostgresqlInput_1"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;salesdb.fixture.invalid&quot;"/>
    <elementParameter field="PASSWORD" name="PASS" value="&quot;enc:system.encryption.key.v1:FIXTURE-NOT-A-REAL-SECRET-2==&quot;"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;orders&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT order_id, cust_id, amount, status FROM sales.orders WHERE order_date &gt;= '&quot; + context.run_date + &quot;'&quot;"/>
  </node>
  <node componentName="tAggregateRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="384" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tAggregateRow_1"/>
    <elementParameter field="TABLE" name="GROUPBYS">
      <elementValue elementRef="OUTPUT_COLUMN" value="cust_id"/>
      <elementValue elementRef="INPUT_COLUMN" value="cust_id"/>
    </elementParameter>
    <elementParameter field="TABLE" name="OPERATIONS">
      <elementValue elementRef="OUTPUT_COLUMN" value="total_amount"/>
      <elementValue elementRef="FUNCTION" value="sum"/>
      <elementValue elementRef="INPUT_COLUMN" value="amount"/>
      <elementValue elementRef="IGNORE_NULL" value="false"/>
    </elementParameter>
  </node>
  <node componentName="tFileOutputDelimited" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="544" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFileOutputDelimited_1"/>
    <elementParameter field="FILE" name="FILENAME" value="&quot;/data/work/order_totals.csv&quot;"/>
  </node>
  <node componentName="tFilterRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="224" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFilterRow_1"/>
    <elementParameter field="CLOSED_LIST" name="LOGICAL_OP" value="&amp;&amp;"/>
    <elementParameter field="TABLE" name="CONDITIONS">
      <elementValue elementRef="INPUT_COLUMN" value="status"/>
      <elementValue elementRef="FUNCTION" value=""/>
      <elementValue elementRef="OPERATOR" value="!="/>
      <elementValue elementRef="RVALUE" value="&quot;CANCELLED&quot;"/>
    </elementParameter>
  </node>
  <connection connectorName="FLOW" label="orders" lineStyle="0" metaname="tPostgresqlInput_1" offsetLabelX="0" offsetLabelY="0" source="tPostgresqlInput_1" target="tFilterRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="orders"/>
  </connection>
  <connection connectorName="FILTER" label="open_orders" lineStyle="0" metaname="tFilterRow_1" offsetLabelX="0" offsetLabelY="0" source="tFilterRow_1" target="tAggregateRow_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="open_orders"/>
  </connection>
  <connection connectorName="FLOW" label="totals" lineStyle="0" metaname="tAggregateRow_1" offsetLabelX="0" offsetLabelY="0" source="tAggregateRow_1" target="tFileOutputDelimited_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="totals"/>
  </connection>
</talendfile:ProcessType>
