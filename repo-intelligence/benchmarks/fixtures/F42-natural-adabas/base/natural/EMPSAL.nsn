* EMPSAL - salary review of one employee: called by EMPMAINT.
DEFINE DATA
PARAMETER
1 #PERSONNEL-ID (A8)
1 #WORK
  2 #NAME (A20)
  2 #ID (N8)
LOCAL
1 EMP VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 NAME
  2 SALARY (P9/1:3)
1 #ISN (P10)
END-DEFINE
*
F1. FIND (1) EMP WITH PERSONNEL-ID = #PERSONNEL-ID
  #ISN := *ISN(F1.)
  #WORK.#NAME := EMP.NAME
END-FIND
GET EMP #ISN
IF EMP.SALARY(1) > 0
  EMP.SALARY(2) := EMP.SALARY(1)
  UPDATE
END-IF
INSERT INTO PAYROLL_AUDIT (PERSONNEL_ID, ACTION) VALUES (#PERSONNEL-ID, 'REVIEW')
END TRANSACTION
END
