DEFINE DATA PARAMETER
1 #PERSONNEL-ID (A8)
1 #NAME (A20)
1 #MSG (A60)
END-DEFINE
FORMAT PS=024 LS=080 ZP=OFF SG=OFF
INPUT (AD=MIT'_' CD=NE)
 001/025 'EMPLOYEE MAINTENANCE' (I)
 004/002 'Personnel ID:'
 004/016 #PERSONNEL-ID (AD=MILT'_' HE='EMPHELP')
 006/002 'Name:' 006/016 #NAME (AD=OD)
 023/002 #MSG (AD=ODL)
END
