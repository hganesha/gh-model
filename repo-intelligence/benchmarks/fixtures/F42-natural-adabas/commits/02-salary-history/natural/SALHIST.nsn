* SALHIST - keep the salary an employee had before a raise.
DEFINE DATA
PARAMETER
1 #PERSONNEL-ID (A8)
LOCAL
1 EMP VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 SALARY (P9/1:3)
1 HIST VIEW OF SALARY-HISTORY
  2 PERSONNEL-ID
  2 OLD-SALARY
  2 CHANGED-ON
END-DEFINE
*
FIND EMP WITH PERSONNEL-ID = #PERSONNEL-ID
  HIST.PERSONNEL-ID := EMP.PERSONNEL-ID
  HIST.OLD-SALARY := EMP.SALARY(2)
  HIST.CHANGED-ON := *DATX
  STORE HIST
END-FIND
END TRANSACTION
END
