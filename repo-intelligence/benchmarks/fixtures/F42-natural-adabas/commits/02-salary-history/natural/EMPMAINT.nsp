* :Mode S
* EMPMAINT - employee maintenance.
* Shows the employee map, raises the salary of the employee asked for,
* lists the employee's vehicles and hands the record to EMPSAL.
DEFINE DATA
LOCAL USING EMPLDA
LOCAL
1 EMP VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 NAME
  2 CITY
  2 SALARY (P9/1:3)
1 VEH VIEW OF VEHICLES
  2 PERSONNEL-ID
  2 MAKE
  2 MODEL
1 #DB-PASSWORD (A32)
1 #NEXT-PROG (A8)
1 #RAISED (N5)
END-DEFINE
*
ASSIGN #DB-PASSWORD = 'fixture-not-a-real-password-0042'
INPUT USING MAP 'EMPMAP'
IF #PERSONNEL-ID = ' '
  ESCAPE ROUTINE
END-IF
*
RD1. READ EMP BY PERSONNEL-ID STARTING FROM #PERSONNEL-ID
  IF EMP.PERSONNEL-ID NE #PERSONNEL-ID
    ESCAPE BOTTOM
  END-IF
  IF EMP.SALARY(1) < 50000
    EMP.SALARY(1) := EMP.SALARY(1) * 1.05
    UPDATE (RD1.)
    ADD 1 TO #RAISED
  END-IF
  FD1. FIND VEH WITH PERSONNEL-ID = EMP.PERSONNEL-ID
    DISPLAY VEH.MAKE VEH.MODEL
  END-FIND
END-READ
END TRANSACTION
*
CALLNAT 'EMPSAL' #PERSONNEL-ID #WORK
IF #RAISED > 0
  CALLNAT 'SALHIST' #PERSONNEL-ID
END-IF
PERFORM SHOW-TOTALS
CALL 'AUDITLOG' #PERSONNEL-ID #RAISED
FETCH RETURN #NEXT-PROG
*
DEFINE SUBROUTINE SHOW-TOTALS
  DECIDE ON FIRST VALUE OF #RAISED
    VALUE 0
      WRITE 'No salary raised'
    VALUE 1:9
      WRITE #RAISED 'salaries raised'
    NONE
      WRITE 'Many salaries raised'
  END-DECIDE
END-SUBROUTINE
END
