*  ACCOUNT INQUIRY MAPSET FOR TRANSACTION AINQ
ACCTMS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB,FRSET)
*
ACCTM1   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,28),LENGTH=15,ATTRB=(ASKIP,BRT),                X
               INITIAL='ACCOUNT INQUIRY'
         DFHMDF POS=(3,1),LENGTH=11,ATTRB=ASKIP,INITIAL='ACCOUNT NO:'
ACCTID   DFHMDF POS=(3,13),LENGTH=10,ATTRB=(UNPROT,NUM,IC,FSET)
         DFHMDF POS=(3,24),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(5,1),LENGTH=5,ATTRB=ASKIP,INITIAL='NAME:'
ACCTNM   DFHMDF POS=(5,13),LENGTH=30,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(6,1),LENGTH=8,ATTRB=ASKIP,INITIAL='BALANCE:'
ACCTBAL  DFHMDF POS=(6,13),LENGTH=15,ATTRB=ASKIP
MSGLINE  DFHMDF POS=(23,1),LENGTH=40,ATTRB=(ASKIP,BRT)
         DFHMSD TYPE=FINAL
         END
