>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STMTGEN.
*> Monthly statements: active accounts from DB2, sorted by branch and account
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT STMT-FILE ASSIGN TO STMTOUT.
    SELECT SORT-WORK ASSIGN TO SORTWK1.
DATA DIVISION.
FILE SECTION.
FD  STMT-FILE.
01  STMT-LINE                PIC X(133).
SD  SORT-WORK.
01  SORT-REC.
    05  SR-BRANCH            PIC X(4).
    05  SR-ACCT-ID           PIC 9(10).
    05  SR-BALANCE           PIC S9(11)V99 COMP-3.
WORKING-STORAGE SECTION.
01  WS-EOF                   PIC X VALUE 'N'.
    88  NO-MORE-ROWS         VALUE 'Y'.
01  WS-BRANCH                PIC X(4).
01  WS-ACCT-ID               PIC 9(10).
01  WS-BALANCE               PIC S9(11)V99 COMP-3.
    EXEC SQL INCLUDE SQLCA END-EXEC.
    EXEC SQL DECLARE ACCT-CSR CURSOR FOR
        SELECT BRANCH, ACCT_ID, BALANCE
          FROM ACCOUNTS
         WHERE STATUS = 'A'
    END-EXEC.
PROCEDURE DIVISION.
MAIN-PARA.
    SORT SORT-WORK ON ASCENDING KEY SR-BRANCH SR-ACCT-ID
        INPUT PROCEDURE IS LOAD-ROWS
        OUTPUT PROCEDURE IS PRINT-STATEMENTS
    EXEC SQL
        INSERT INTO STATEMENT_RUNS (RUN_DATE) VALUES (CURRENT DATE)
    END-EXEC
    GOBACK.
LOAD-ROWS.
    EXEC SQL OPEN ACCT-CSR END-EXEC
    PERFORM UNTIL NO-MORE-ROWS
        EXEC SQL
            FETCH ACCT-CSR INTO :WS-BRANCH, :WS-ACCT-ID, :WS-BALANCE
        END-EXEC
        IF SQLCODE = 100
            SET NO-MORE-ROWS TO TRUE
        ELSE
            MOVE WS-BRANCH TO SR-BRANCH
            MOVE WS-ACCT-ID TO SR-ACCT-ID
            MOVE WS-BALANCE TO SR-BALANCE
            RELEASE SORT-REC
        END-IF
    END-PERFORM
    EXEC SQL CLOSE ACCT-CSR END-EXEC.
PRINT-STATEMENTS.
    OPEN OUTPUT STMT-FILE
    MOVE 'N' TO WS-EOF
    PERFORM UNTIL NO-MORE-ROWS
        RETURN SORT-WORK
            AT END SET NO-MORE-ROWS TO TRUE
            NOT AT END
                MOVE SORT-REC TO STMT-LINE
                WRITE STMT-LINE
        END-RETURN
    END-PERFORM
    CLOSE STMT-FILE.
