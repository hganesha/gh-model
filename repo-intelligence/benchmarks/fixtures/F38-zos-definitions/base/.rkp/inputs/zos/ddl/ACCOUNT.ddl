CREATE TABLESPACE ACCTTS IN ACCTDB USING STOGROUP ACCTSG;
CREATE TABLE ACCT.ACCOUNT
  ( ACCT_ID    CHAR(10)      NOT NULL,
    ACCT_NAME  VARCHAR(40)   NOT NULL,
    BALANCE    DECIMAL(11,2) NOT NULL WITH DEFAULT,
    OPENED     DATE          NOT NULL,
    PRIMARY KEY (ACCT_ID)
  ) IN ACCTDB.ACCTTS
    CCSID EBCDIC;
CREATE UNIQUE INDEX ACCT.XACCT01 ON ACCT.ACCOUNT (ACCT_ID);
