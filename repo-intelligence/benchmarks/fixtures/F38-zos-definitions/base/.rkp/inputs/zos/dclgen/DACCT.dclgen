      ******************************************************************
      * DCLGEN TABLE(ACCT.ACCOUNT)                                     *
      *        LIBRARY(PROD.ACCT.DCLGEN(DACCT))                        *
      *        LANGUAGE(COBOL)                                         *
      *        QUOTE                                                   *
      ******************************************************************
           EXEC SQL DECLARE ACCT.ACCOUNT TABLE
           ( ACCT_ID                        CHAR(10) NOT NULL,
             ACCT_NAME                      VARCHAR(40) NOT NULL,
             BALANCE                        DECIMAL(11, 2),
             OPENED                         DATE NOT NULL
           ) END-EXEC.
      ******************************************************************
      * COBOL DECLARATION FOR TABLE ACCT.ACCOUNT                       *
      ******************************************************************
       01  DCLACCOUNT.
           10 ACCT-ID              PIC X(10).
           10 ACCT-NAME.
              49 ACCT-NAME-LEN     PIC S9(4) USAGE COMP.
              49 ACCT-NAME-TEXT    PIC X(40).
           10 BALANCE              PIC S9(9)V9(2) USAGE COMP-3.
           10 OPENED               PIC X(10).
      ******************************************************************
      * THE NUMBER OF COLUMNS DESCRIBED BY THIS DECLARATION IS 4       *
      ******************************************************************
