* CSD EXTRACT FOR GROUP ACCTGRP
DEFINE TRANSACTION(ACIN) GROUP(ACCTGRP) PROGRAM(ACCTINQ)
       PROFILE(DFHCICST) TRANCLASS(DFHTCL00)
       DESCRIPTION(ACCOUNT INQUIRY)
DEFINE PROGRAM(ACCTINQ) GROUP(ACCTGRP) LANGUAGE(COBOL)
       DATALOCATION(ANY) EXECKEY(USER)
DEFINE FILE(ACCTMST) GROUP(ACCTGRP) DSNAME(PROD.ACCT.MASTER)
       RECORDFORMAT(F) READ(YES) BROWSE(YES) UPDATE(NO)
       ADD(NO) DELETE(NO)
DEFINE DB2ENTRY(ACCTENT) GROUP(ACCTGRP) PLAN(ACCTPLN) TRANSID(ACIN)
DEFINE MAPSET(ACCTSET) GROUP(ACCTGRP)
ADD GROUP(ACCTGRP) LIST(ACCTLIST)
