//ACCTD01  JOB (ACCT),'ACCOUNTS DAILY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*  DAILY ACCOUNT POSTING: RELOAD THE MASTER, EXTRACT, SUMMARISE, POST
//         JCLLIB ORDER=(PROD.ACCT.PROCLIB)
//         SET ENV=PROD
//*
//EXTRACT  PROC HLQ=&ENV,CYCLE=WEEKLY
//EXTR     EXEC PGM=ACCTEXT
//ACCTIN   DD DSN=&HLQ..ACCT.MASTER,DISP=SHR
//ACCTOUT  DD DSN=&HLQ..ACCT.&CYCLE..EXTRACT,DISP=(NEW,CATLG),
//            SPACE=(CYL,(5,5)),UNIT=SYSDA
//SYSOUT   DD SYSOUT=*
//         PEND
//*
//RELOAD   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SEQIN    DD DSN=PROD.ACCT.MASTER.BACKUP,DISP=SHR
//SYSIN    DD *
  DELETE PROD.ACCT.MASTER CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(PROD.ACCT.MASTER) -
         INDEXED KEYS(10 0) RECORDSIZE(200 200) -
         CYLINDERS(10 5)) -
       DATA (NAME(PROD.ACCT.MASTER.DATA)) -
       INDEX (NAME(PROD.ACCT.MASTER.INDEX))
  REPRO INFILE(SEQIN) OUTDATASET(PROD.ACCT.MASTER)
/*
//EXTRACT1 EXEC EXTRACT,CYCLE=DAILY
//EXTR.ACCTLOG DD DSN=PROD.ACCT.EXTRACT.LOG,DISP=MOD
//*
//SORTSUM  EXEC PGM=SORT,COND=(4,LT)
//SORTIN   DD DSN=*.EXTRACT1.EXTR.ACCTOUT,DISP=SHR
//SORTOUT  DD DSN=PROD.ACCT.SUMMARY.DAILY(+1),DISP=(NEW,CATLG),
//            SPACE=(CYL,(1,1))
//SYSIN    DD *
  INCLUDE COND=(11,2,CH,EQ,C'01',AND,50,8,PD,GT,0)
  INREC FIELDS=(1,10,50,8)
  SORT FIELDS=(1,10,CH,A)
  SUM FIELDS=(11,8,PD)
/*
//POST     EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=PROD.ACCT.LOADLIB,DISP=SHR
//ACCTIN   DD DSN=PROD.ACCT.DAILY.EXTRACT,DISP=SHR
//ACCTMST  DD DSN=PROD.ACCT.MASTER,DISP=OLD
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(ACCTPOST) PLAN(ACCTPLN) -
      PARMS('/DAILY')
  END
  %ACCTRPT
/*
//RECON    EXEC PGM=ACCTRCN,COND=(0,NE,POST)
//ACCTMST  DD DSN=PROD.ACCT.MASTER,DISP=SHR
//ACCTIN   DD DSN=PROD.ACCT.DAILY.EXTRACT,DISP=SHR
//RECONRPT DD DSN=PROD.ACCT.RECON.REPORT,DISP=(NEW,CATLG),
//            SPACE=(TRK,(5,5))
//         IF (POST.RC = 0) THEN
//ARCHIVE  EXEC ACCTARCH,GEN=+1
//         ELSE
//ALERT    EXEC PGM=ACCTALRT
//ALERTS   DD DSN=PROD.ACCT.ALERTS,DISP=MOD
//         ENDIF
//
