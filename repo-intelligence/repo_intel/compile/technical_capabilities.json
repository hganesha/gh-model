    {"key": "yaml-processing", "name": "YAML Processing", "description": "Parse or serialize YAML documents."},
    {"key": "application-server", "name": "Application Server", "description": "Run a web application and serve requests over HTTP."},
    {"key": "distributed-data-processing", "name": "Distributed Data Processing", "description": "Read, transform and write large datasets across a cluster or in parallel.", "aliases": ["big data", "Spark"]},
    {"key": "workflow-orchestration", "name": "Workflow Orchestration", "description": "Schedule and run directed graphs of batch tasks.", "aliases": ["DAG scheduler", "orchestrator"]},
