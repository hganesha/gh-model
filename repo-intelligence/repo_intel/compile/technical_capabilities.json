    {"key": "ml-model-training", "name": "Machine Learning Model Training", "description": "Fit, train or fine-tune machine learning models.", "aliases": ["ML framework", "deep learning"]},
    {"key": "ml-experiment-tracking", "name": "ML Experiment Tracking and Registry", "description": "Record training runs, metrics and models, and register model versions.", "aliases": ["model registry"]},
    {"key": "pretrained-model-library", "name": "Pretrained Model Library", "description": "Load and run pretrained models and tokenizers.", "aliases": ["model hub"]},
    {"key": "data-platform-sdk", "name": "Data Platform SDK", "description": "Manage jobs, clusters, workspaces and assets on a hosted data or ML platform."},
